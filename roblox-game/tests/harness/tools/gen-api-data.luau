--[[
	Generates tests/harness/mocks/ApiData.luau from a Roblox API dump (the JSON published by Roblox, e.g. API-Dump.json).

	Usage:  lune run tests/harness/tools/gen-api-data.luau <path/to/API-Dump.json> [output path]

	The data file is what lets the harness tell "exists in Roblox but is not mocked" apart from "is not a member at all",
	gives every instance its events, and marks read-only / deprecated / script-inaccessible members. It is committed;
	rerun this only to move to a newer API dump.

	Output format (one entry per class, strings are space separated lists):
		s = superclass name
		t = class tags ("NotCreatable", "Service", "Deprecated" ...)
		p = properties   "Name:Type[:flags]"   Type: primitive/datatype name, "@Class" for instance refs, "E.Name" for enums
		                 flags: r = read-only for game scripts, d = deprecated, h = hidden
		f = functions    "Name" with optional prefix chars: "~" deprecated, "*" yields
		e = events       "Name" ("~" prefix = deprecated)
		c = callbacks    "Name"
		x = members game scripts cannot use (plugin/Roblox security, NotScriptable)
]]
local fs = require("@lune/fs")
local process = require("@lune/process")
local serde = require("@lune/serde")

local inputPath = process.args[1]
assert(inputPath, "usage: lune run gen-api-data.luau <API-Dump.json> [output]")
local scriptPath = debug.info(1, "s")
local toolsDir = string.match(scriptPath, "^(.*)/gen%-api%-data") or "."
local outputPath = process.args[2] or (toolsDir .. "/../mocks/ApiData.luau")

local dump = serde.decode("json", fs.readFile(inputPath))

local function hasTag(tags: { any }?, name: string): boolean
	if tags then
		for _, tag in tags do
			if tag == name then
				return true
			end
		end
	end
	return false
end

-- Security is either a string (functions/events/callbacks) or { Read, Write } (properties).
local function readable(security: any): boolean
	if type(security) == "table" then
		return security.Read == "None"
	end
	return security == nil or security == "None"
end

local function writable(security: any): boolean
	if type(security) == "table" then
		return security.Write == "None"
	end
	return true
end

local function typeName(valueType: any): string
	if valueType.Category == "Class" then
		return "@" .. valueType.Name
	elseif valueType.Category == "Enum" then
		return "E." .. valueType.Name
	end
	return valueType.Name
end

table.sort(dump.Classes, function(a, b)
	return a.Name < b.Name
end)

local lines = {
	"-- GENERATED by tests/harness/tools/gen-api-data.luau - do not edit by hand.",
	"-- Compact per-class member lists from the Roblox API dump (format documented in the generator).",
	"return {",
}
local classCount, memberCount = 0, 0
for _, class in dump.Classes do
	local props, funcs, events, callbacks, hidden = {}, {}, {}, {}, {}
	table.sort(class.Members, function(a, b)
		if a.Name == b.Name then
			return a.MemberType < b.MemberType
		end
		return a.Name < b.Name
	end)
	local seen = {}
	for _, member in class.Members do
		-- a few classes list the same name twice (overloads); keep the first
		local seenKey = member.MemberType .. ":" .. member.Name
		if seen[seenKey] then
			continue
		end
		seen[seenKey] = true
		memberCount += 1
		local deprecated = hasTag(member.Tags, "Deprecated")
		if not readable(member.Security) or hasTag(member.Tags, "NotScriptable") then
			table.insert(hidden, member.Name)
		elseif member.MemberType == "Property" then
			local flags = ""
			if hasTag(member.Tags, "ReadOnly") or not writable(member.Security) then
				flags ..= "r"
			end
			if deprecated then
				flags ..= "d"
			end
			if hasTag(member.Tags, "Hidden") then
				flags ..= "h"
			end
			local entry = member.Name .. ":" .. typeName(member.ValueType)
			if flags ~= "" then
				entry ..= ":" .. flags
			end
			table.insert(props, entry)
		elseif member.MemberType == "Function" then
			local prefix = ""
			if deprecated then
				prefix ..= "~"
			end
			if hasTag(member.Tags, "Yields") then
				prefix ..= "*"
			end
			table.insert(funcs, prefix .. member.Name)
		elseif member.MemberType == "Event" then
			table.insert(events, (if deprecated then "~" else "") .. member.Name)
		elseif member.MemberType == "Callback" then
			table.insert(callbacks, member.Name)
		end
	end
	local fields = {}
	if class.Superclass and class.Superclass ~= "<<<ROOT>>>" then
		table.insert(fields, string.format("s=%q", class.Superclass))
	end
	if class.Tags and #class.Tags > 0 then
		local tags = {}
		for _, tag in class.Tags do
			if type(tag) == "string" then
				table.insert(tags, tag)
			end
		end
		table.insert(fields, string.format("t=%q", table.concat(tags, " ")))
	end
	for _, pair in { { "p", props }, { "f", funcs }, { "e", events }, { "c", callbacks }, { "x", hidden } } do
		if #pair[2] > 0 then
			table.insert(fields, string.format("%s=%q", pair[1], table.concat(pair[2], " ")))
		end
	end
	table.insert(lines, string.format("[%q]={%s},", class.Name, table.concat(fields, ",")))
	classCount += 1
end
table.insert(lines, "}")
table.insert(lines, "")
fs.writeFile(outputPath, table.concat(lines, "\n"))
print(`wrote {outputPath}: {classCount} classes, {memberCount} members`)
