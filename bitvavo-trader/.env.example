# ─────────────────────────────────────────────────────────────────────────────
#  bitvavo-trader — instellingen
#
#  Kopieer dit bestand naar ".env" (in dezelfde map) en pas aan wat je wilt.
#  Zonder .env draait de bot gewoon in OEFENMODUS (paper trading) met nep-geld.
#  Het .env-bestand bevat geheimen: deel het nooit en zet het nooit online.
# ─────────────────────────────────────────────────────────────────────────────

# ── Handelsmodus ─────────────────────────────────────────────────────────────
# paper = oefenen met nep-geld (standaard, veilig)
# live  = ECHT geld op Bitvavo. Alleen gebruiken als je de risico's begrijpt!
#         In live mode start de bot nooit automatisch en moet je hem in het
#         dashboard eerst "armen" met de tekst "IK BEGRIJP HET RISICO".
TRADING_MODE=paper

# ── Marktdata ────────────────────────────────────────────────────────────────
# auto      = echte Bitvavo-koersen als Bitvavo bereikbaar is, anders simulatie
# bitvavo   = altijd echte Bitvavo-koersen (stopt met een fout als dat niet lukt)
# simulated = altijd gesimuleerde koersen (handig om te testen, niet voor live)
DATA_SOURCE=auto

# ── Bitvavo API-sleutel (alleen nodig voor live trading) ─────────────────────
# !!! BELANGRIJK !!!
#  - Maak de API-sleutel aan ZONDER opnamerechten ("withdraw" UIT).
#    Dan kan niemand met deze sleutel geld van je account afhalen.
#  - Zet een IP-whitelist aan (alleen het IP-adres van jouw computer).
#  - Geef alleen de rechten "Bekijken" en "Handelen".
# Laat deze leeg voor paper trading.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
# Operator-id dat Bitvavo verplicht meestuurt bij orders (1 is prima)
BITVAVO_OPERATOR_ID=1

# ── Dashboard ────────────────────────────────────────────────────────────────
# Het dashboard is standaard alleen vanaf je eigen computer bereikbaar.
# Verander HOST alleen als je weet wat je doet (en zet dan een DASHBOARD_TOKEN).
# Live mode weigert te starten met een andere HOST dan 127.0.0.1/localhost/::1
# zolang DASHBOARD_TOKEN leeg is.
HOST=127.0.0.1
PORT=4321
# Optioneel wachtwoord (minstens 8 tekens) voor het dashboard/de API.
# Leeg = geen wachtwoord: acceptabel voor oefenen met HOST=127.0.0.1. Voor live
# trading raden we een token sterk aan, ook op 127.0.0.1 (dan kan geen ander
# programma of andere website op je computer de bot bedienen).
DASHBOARD_TOKEN=

# ── Geld ─────────────────────────────────────────────────────────────────────
# Startkapitaal (EUR) voor de oefenmodus als er maar ÉÉN bot draait
# (bij meerdere bots: zie PAPER_CAPITAL_PER_BOT hieronder)
PAPER_STARTING_CAPITAL=50
# Live mode: de live-bot gebruikt NOOIT meer dan dit bedrag (EUR) van je saldo
CAPITAL_LIMIT_EUR=50

# ── Bot-wedstrijd: meerdere bots tegelijk ────────────────────────────────────
# Standaard draaien er VIER bots naast elkaar, elk met een eigen budget en een
# eigen manier van handelen. In het dashboard (tabblad "Wedstrijd") zie je welke
# het beste werkt. Alle bots gebruiken dezelfde koersen.
#   scalper  = Snelle scalper: 5-minutencandles, pakt kleine winsten snel
#   trend    = Trendvolger: 1-uurscandles, koopt alleen als de markt stijgt en
#              laat winst lang doorlopen
#   dip      = Dip-koper: 15-minutencandles, koopt na een harde daling en
#              verkoopt bij het herstel
#   allround = Allrounder: alle strategieën samen (de bot zoals je hem kent)
# Welke bots meedoen, komma-gescheiden (bijv. BOTS=trend,dip). Leeg = alle vier.
# Met één bot (bijv. BOTS=allround) werkt alles zoals vroeger: dezelfde bestanden
# in DATA_DIR, PAPER_STARTING_CAPITAL, en MARKETS/INTERVAL hieronder tellen mee.
BOTS=scalper,trend,dip,allround
# Startkapitaal (EUR, nep-geld) van ELKE bot als er meer dan één bot is.
# Minimaal 5. Elke bot bewaart zijn eigen toestand en instellingen in
# <DATA_DIR>/bots/<naam>/.
PAPER_CAPITAL_PER_BOT=25
# Alleen voor live mode (TRADING_MODE=live) met meer dan één bot: welke ENE bot
# met echt geld handelt, bijv. LIVE_BOT=trend. Die bot gebruikt maximaal
# CAPITAL_LIMIT_EUR; de andere bots blijven oefenen met nep-geld (op de echte
# koersen). Er kan maar één bot live zijn: je hebt één Bitvavo-account.
# Zonder LIVE_BOT start live mode met meerdere bots niet. In oefenmodus doet
# LIVE_BOT niets. Wissel je van live-bot terwijl de vorige nog open posities had,
# dan weigert de bot te starten tot die posities gesloten zijn.
LIVE_BOT=

# ── Opslag ───────────────────────────────────────────────────────────────────
# Map voor de opgeslagen toestand, instellingen en cache (relatief aan de projectmap)
DATA_DIR=./data

# ── Strategie-instellingen (kun je ook in het dashboard aanpassen) ───────────
# Let op: bij MEERDERE bots worden MARKETS en INTERVAL hieronder genegeerd: elke
# bot volgt zijn eigen stijl. Pas een bot aan in zijn eigen dashboard (tabblad
# Instellingen); dat wordt bewaard in <DATA_DIR>/bots/<naam>/config.json.
# Bij ÉÉN bot: zodra je in het dashboard instellingen opslaat, gelden die uit
# <DATA_DIR>/config.json en worden MARKETS/INTERVAL hieronder genegeerd (de bot
# meldt dat bij het starten). Verwijder dat bestand om .env weer te laten gelden.
# Welke munten de bot volgt (maximaal 400):
#   auto      = de bot kiest zelf de 30 munten met de meeste handel (elk uur
#               opnieuw; stablecoins en munten met weinig handel vallen af)
#   auto:N    = hetzelfde, maar dan N munten, bijv. auto:10 of auto:100
#   een lijst = precies deze markten, komma-gescheiden en altijd -EUR,
#               bijv. BTC-EUR,ETH-EUR,SOL-EUR
# Leeg of weggelaten = auto (30 munten).
MARKETS=auto:30
# Candle-interval: 1m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h of 1d
INTERVAL=15m
# Bots automatisch starten bij opstarten (alleen de bots die oefenen; een
# live-bot start nooit vanzelf)
AUTOSTART=true
