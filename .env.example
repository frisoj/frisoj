# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL (Project Settings -> API). Public, safe for client use.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings -> API). Public, safe for client use.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings -> API). SECRET — server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Mollie API key (live or test, e.g. test_xxx / live_xxx) used for creating payments server-side. SECRET.
MOLLIE_API_KEY=

# Publicly reachable URL Mollie should call to confirm payment status changes, e.g. https://www.purelitter.nl/api/mollie/webhook.
MOLLIE_WEBHOOK_URL=

# Resend API key for transactional email (order confirmations, etc). SECRET.
RESEND_API_KEY=

# Inbox that receives the "place this order with the supplier" notification email. Placeholder until the real owner inbox is set.
OWNER_NOTIFICATION_EMAIL=

# Comma-separated list of email addresses allowed to sign in to /admin, e.g. "owner@purelitter.nl,ops@purelitter.nl". SECRET-ish (access control, keep private).
ADMIN_EMAILS=

# Shared secret required (as `Authorization: Bearer <value>`) to call the /api/cron/* routes; set the same value in the Vercel Cron config. SECRET.
CRON_SECRET=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Public.
NEXT_PUBLIC_GA4_ID=

# Meta (Facebook/Instagram) Pixel ID. Public.
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel ID. Public.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Canonical site URL used for metadata, canonical tags, JSON-LD and Mollie/email redirect links (e.g. https://www.purelitter.nl).
NEXT_PUBLIC_SITE_URL=
